    local function bounds(character,camera,head)
        local root=character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
        if root and root:IsA("BasePart") then
            local s=camera:WorldToViewportPoint(root.Position)
            if s.Z<=0 then return nil,nil,nil,nil end
        end
        local minX3,minY3,minZ3=math.huge,math.huge,math.huge
        local maxX3,maxY3,maxZ3=-math.huge,-math.huge,-math.huge
        local foundAny=false
        local function expandPart(part)
            if not part then return end
            local cf,half=part.CFrame,part.Size*0.5
            local right=cf.RightVector*half.X
            local up=cf.UpVector*half.Y
            local look=cf.LookVector*half.Z
            local c=cf.Position
            local pX=math.abs(right.X)+math.abs(up.X)+math.abs(look.X)
            local pY=math.abs(right.Y)+math.abs(up.Y)+math.abs(look.Y)
            local pZ=math.abs(right.Z)+math.abs(up.Z)+math.abs(look.Z)
            if c.X-pX<minX3 then minX3=c.X-pX end
            if c.X+pX>maxX3 then maxX3=c.X+pX end
            if c.Y-pY<minY3 then minY3=c.Y-pY end
            if c.Y+pY>maxY3 then maxY3=c.Y+pY end
            if c.Z-pZ<minZ3 then minZ3=c.Z-pZ end
            if c.Z+pZ>maxZ3 then maxZ3=c.Z+pZ end
            foundAny=true
        end
        for _,c in character:GetChildren() do
            if c:IsA("BasePart") and BODY_PART_SET[c.Name] then expandPart(c) end
        end
        if not foundAny and head and head:IsA("BasePart") then expandPart(head) end
        if not foundAny then
            if root and root:IsA("BasePart") then
                local s=camera:WorldToViewportPoint(root.Position)
                if s.Z>0 then
                    local scale=math.clamp(220/math.max(s.Z,1),8,90)
                    return s.X-scale*0.35,s.Y-scale*0.825,scale*0.7,scale*1.5
                end
            end
            return nil,nil,nil,nil
        end
        local midTest=camera:WorldToViewportPoint(Vector3.new((minX3+maxX3)*0.5,(minY3+maxY3)*0.5,(minZ3+maxZ3)*0.5))
        if midTest.Z<=0 then return nil,nil,nil,nil end
        local minX,minY,maxX,maxY=math.huge,math.huge,-math.huge,-math.huge
        local any=false
        local function mark(x,y,z)
            local s,on=camera:WorldToViewportPoint(Vector3.new(x,y,z))
            if s.Z>0 and on then
                any=true
                if s.X<minX then minX=s.X end
                if s.Y<minY then minY=s.Y end
                if s.X>maxX then maxX=s.X end
                if s.Y>maxY then maxY=s.Y end
            end
        end
        mark(minX3,minY3,minZ3); mark(minX3,minY3,maxZ3); mark(minX3,maxY3,minZ3); mark(minX3,maxY3,maxZ3)
        mark(maxX3,minY3,minZ3); mark(maxX3,minY3,maxZ3); mark(maxX3,maxY3,minZ3); mark(maxX3,maxY3,maxZ3)
        if not any then
            if root and root:IsA("BasePart") then
                local s=camera:WorldToViewportPoint(root.Position)
                if s.Z>0 then
                    local scale=math.clamp(220/math.max(s.Z,1),8,90)
                    return s.X-scale*0.35,s.Y-scale*0.825,scale*0.7,scale*1.5
                end
            end
            return nil,nil,nil,nil
        end
        local w=math.max(maxX-minX,4)
        local h=math.max(maxY-minY,4)
        local pad=h*0.1
        return minX,minY-pad*0.25,w,h+pad*0.65
    end

