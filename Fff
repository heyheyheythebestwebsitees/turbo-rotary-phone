    local function gradientWeights(character,parts)
        local root=character:FindFirstChild("HumanoidRootPart")
        local origin,up=Vector3.zero,Vector3.yAxis
        if root and root:IsA("BasePart") then origin=root.Position; up=root.CFrame.UpVector end
        local heights,top,bottom={},-math.huge,math.huge
        for _,p in parts do
            local h=(p.Position-origin):Dot(up); heights[p]=h
            local half=p.Size.Y*0.5
            if h+half>top then top=h+half end
            if h-half<bottom then bottom=h-half end
        end
        local span=math.max(top-bottom,0.01)
        local out={}
        for p,h in heights do out[p]=math.clamp((top-h)/span,0,1) end
        return out
    end
