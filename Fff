local function installHitFxRuntime()
    local DrawingLib=rawget(_G,"Drawing")
    if not DrawingLib then
        local env=execApi("getgenv")
        if type(env)=="table" then DrawingLib=env.Drawing end
    end
    local hitMarks={}
    local function hitLine()
        if not DrawingLib then return nil end
        local ok,l=pcall(function() return DrawingLib.new("Line") end)
        if not ok or not l then return nil end
        l.Visible=false; l.Thickness=1; l.Transparency=1; l.ZIndex=55
        return l
    end
    local function hide(m) if m.a then m.a.Visible=false end; if m.b then m.b.Visible=false end end
    DrawingBridge.spawnHitFx=function(pos,player)
        if HitFx.enabled~=true or typeof(pos)~="Vector3" or not DrawingLib then return end
        if #hitMarks>=12 then
            local old=table.remove(hitMarks,1)
            if old then hide(old) end
        end
        local a,b=hitLine(),hitLine()
        if not a or not b then return end
        table.insert(hitMarks,{pos=pos,player=player,born=os.clock(),off=Vector2.new((math.random()-0.5)*18,(math.random()-0.5)*18),a=a,b=b})
    end
    RunService.RenderStepped:Connect(function()
        local count=#hitMarks
        if count==0 then return end
        local cam=Workspace.CurrentCamera
        local now=os.clock()
        local life=math.clamp(HitFx.fade,0.08,2)
        local tint=HitFx.color
        for i=count,1,-1 do
            local m=hitMarks[i]
            local age=now-m.born
            if age>=life or not cam then hide(m); table.remove(hitMarks,i); continue end
            local u=age/life
            local alpha=if u<0.18 then u/0.18 else 1-((u-0.18)/0.82)
            local world=m.pos
            if HitFx.anchor and m.player and m.player.Parent then
                local ch=m.player.Character
                local root=ch and (ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Head"))
                if root and root:IsA("BasePart") then world=root.Position end
            end
            local sp,on=cam:WorldToViewportPoint(world)
            local show=HitFx.enabled==true and on and sp.Z>0
            local c=Vector2.new(sp.X,sp.Y)+m.off
            local d=3.2*0.7071
            m.a.From=Vector2.new(c.X-d,c.Y-d); m.a.To=Vector2.new(c.X+d,c.Y+d)
            m.b.From=Vector2.new(c.X-d,c.Y+d); m.b.To=Vector2.new(c.X+d,c.Y-d)
            m.a.Color=tint; m.b.Color=tint
            m.a.Transparency=alpha; m.b.Transparency=alpha
            m.a.Visible=show; m.b.Visible=show
        end
    end)
