        if not onshotLive() then
            if next(hpTrack) or next(pendingDrops) then hpTrack={}; pendingDrops={} end
            dealtFallback=nil
            return
        end
        local camera=Workspace.CurrentCamera
        if not camera then return end
        for player,track in hpTrack do
            local hp=track.humanoid.Health
            if hp<track.hp-0.05 and now-track.shotAt>0.05 and track.character.Parent then
                track.shotAt=now
                local snap=snapshotCharacter(track.character)
                if snap then
                    if now-lastDealtAt<=ONSHOT_WINDOW then
                        pendingDrops[player]=nil; dealtFallback=nil
                        lastSpawnAt=now; spawnOnshot(snap,now)
                    else
                        pendingDrops[player]={snap=snap,at=now}
                    end
                end
            end
            track.hp=hp
        end
        local fb=dealtFallback
        if fb and now-fb.at>ONSHOT_WINDOW then
            dealtFallback=nil
            if lastSpawnAt<fb.at then lastSpawnAt=now; spawnOnshot(fb.snap,now) end
        end
        for _,player in Players:GetPlayers() do
            local c,h=liveEnemy(player)
            local track=hpTrack[player]
            if c and h then
                if not track or track.humanoid~=h then
                    hpTrack[player]={character=c,humanoid=h,hp=h.Health,shotAt=0}
                end
            elseif track then hpTrack[player]=nil end
        end
        for p in hpTrack do if p.Parent==nil then hpTrack[p]=nil end end
