local function callAsGame(fn,...)
    local setid=execApi("setthreadidentity") or setthreadidentity
    if setid then
        pcall(setid,2)
        local ok,err=pcall(fn,...)
        pcall(setid,8)
        return ok,err
    end
    return pcall(fn,...)
end

local function hookGameMethod(func,replacement)
    local hf=execApi("hookfunction") or hookfunction
    local ncc=execApi("newcclosure") or newcclosure or function(f) return f end
    if not hf then return func end
    local old
    old=hf(func,ncc(function(...) return replacement(old,...) end))
    return old
end

