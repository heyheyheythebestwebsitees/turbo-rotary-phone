local function sleepy_ragebot_step()
    local hrp=getHrp(); local hum=getHum()
    if not hrp or not hum or hum.Health<=0 then return end
    local fighter=Game.localFighter()
    local item=fighter and fighter.EquippedItem

    if Sleepy_Config.antiaim_enabled then
        local newCf=antiaim_apply_rotation(hrp.CFrame,math.rad(tonumber(Sleepy_Config.antiaim_yaw_angle) or 90),math.rad(tonumber(Sleepy_Config.antiaim_pitch_angle) or 89),tonumber(Sleepy_Config.antiaim_speed) or 3)
        rage_lite_rotation(newCf,false)
    end

    if not rage_lite_engaged() then return end

    local targetModel,targetPart=FOV1_pick()
    if not targetPart then rage_lite.target=nil; return end
    rage_lite.target=targetPart

    local distance=(targetPart.Position-hrp.Position).Magnitude
    local isBlocking=Sleepy_Config.rage_lite_shield_block and rage_lite_shield(fighter)
    local knifeLower,knifeUpper=rage_lite_compute_knife(fighter,targetPart,distance,isBlocking)

    if item and item.Name=="Knife" and tick()>=rage_lite.knife_next then
        rage_lite.knife_burst=(rage_lite.knife_burst or 0)+1
        if rage_lite.knife_burst>RAGE_LITE_KNIFE_BURST then rage_lite.knife_burst=0 end
        rage_lite_rotation(hrp.CFrame,isBlocking)
        local payload={
            [utf8.char(1)]=rage_lite_camera_data(knifeLower,knifeUpper),
            [utf8.char(2)]=fighter and fighter:ToEnum("HeavyAttack"..(rage_lite.knife_burst%3+1)) or nil,
        }
        rage_lite_fire(item,"StartAiming",payload)
        rage_lite_fire(item,"StartShooting",payload)
        rage_lite_rotation(knifeUpper,false)
        rage_lite_fire(item,"FinishShooting",payload)
        rage_lite.knife_next=tick()+RAGE_LITE_KNIFE_SPACING
    elseif item and tick()>=(rage_lite.attack_at or 0) then
        rage_lite_physics_step(fighter)
    end

    if Cam and Sleepy_Config.manipulation_enabled then manip_update(Cam.CFrame.Position) end
end

