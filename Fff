local ANTIAIM_TAU=math.pi*2
local function antiaim_apply_yaw(baseYaw,angle,speed)
    local t=Sleepy_Config.antiaim_yaw_type
    if t=="Backwards" then return baseYaw+math.pi
    elseif t=="Left" then return baseYaw+angle
    elseif t=="Right" then return baseYaw-angle
    elseif t=="Spin" then return tick()*speed*math.pi
    elseif t=="Sway" then return baseYaw+math.sin(tick()*speed*3)*angle
    elseif t=="Jitter" then return baseYaw+(math.floor(tick()*speed*10)%2==0 and angle or -angle)
    elseif t=="Random" then return math.random()*ANTIAIM_TAU
    elseif t=="Offset" then return baseYaw+angle
    elseif t=="Custom" then return angle end
    return baseYaw
end
local function antiaim_apply_pitch(basePitch,angle,speed)
    local t=Sleepy_Config.antiaim_pitch_type
    if t=="Up" then return -angle
    elseif t=="Down" then return angle
    elseif t=="Up & Down" then return math.floor(tick()*speed*4)%2==0 and -angle or angle
    elseif t=="Random" then return math.rad(math.random(0,360))
    elseif t=="Offset" then return basePitch+angle
    elseif t=="Custom" then return angle end
    return basePitch
end
local function antiaim_apply_rotation(cframe,yaw,pitch,speed)
    local baseYaw,basePitch=cframe:ToOrientation()
    return CFrame.new(cframe.Position)*CFrame.fromOrientation(antiaim_apply_pitch(basePitch,pitch,speed),antiaim_apply_yaw(baseYaw,yaw,speed),0)
end

local function FOV1_get_target(originPos)
    local hrp=getHrp(); if not hrp then return nil,nil end
    local origin=originPos or (Cam and Cam.CFrame.Position) or hrp.Position
    local bestModel,bestPart,bestDist=nil,nil,math.huge
    local lowestHealth=Sleepy_Config.ragebot_target_method=="Lowest Health"
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local model=plr.Character
            if model then
                local eHrp=model:FindFirstChild("HumanoidRootPart")
                local eHum=model:FindFirstChildOfClass("Humanoid")
                if eHrp and eHum and eHum.Health>0 then
                    local fighter=Game.localFighter()
                    local skip=false
                    if fighter then
                        local ok,inv=pcall(function() return fighter.Entity and fighter.Entity:Get("IsInvincible") end)
                        if ok and inv then skip=true end
                    end
                    if not skip then
                        local part=model:FindFirstChild("Head") or eHrp
                        if part then
                            local dist=lowestHealth and eHum.Health or (part.Position-origin).Magnitude
                            if ragebot_priority[plr] then dist=dist-(Sleepy_Config.ragebot_priority_bonus or 100) end
                            if dist<bestDist then bestDist,bestModel,bestPart=dist,model,part end
                        end
                    end
                end
            end
        end
    end
    return bestModel,bestPart
end
local function FOV1_pick()
    local model,part=FOV1_get_target()
    FOV1MainTarget.target.target=model
    FOV1MainTarget.target.hit_part=part
    return model,part
end

