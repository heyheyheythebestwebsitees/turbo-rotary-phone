        local folder=chamsContainer(); if not folder then return end
        while #onshots>=ONSHOT_MAX do destroyOnshot(1) end
        local anchor=onshotAnchor(); if not anchor then return end
        local aCf=anchor.CFrame
        local alpha=math.clamp(Esp.onshotTransparency,0,0.95)
        local boxes=table.create(#snap.cframes)
        for i,cf in snap.cframes do
            local box=Instance.new("BoxHandleAdornment")
            box.AlwaysOnTop=true; box.ZIndex=6
            box.Size=snap.sizes[i]; box.CFrame=aCf:ToObjectSpace(cf)
            box.Transparency=alpha; box.Visible=false
            box.Adornee=anchor; box.Parent=folder
            boxes[i]=box
        end
        table.insert(onshots,{boxes=boxes,weights=snap.weights,probe=snap.probe,born=now,occluded=nil,shown=nil,rayAt=-1,paintDirty=true})
