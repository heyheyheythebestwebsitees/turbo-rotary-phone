local function rage_lite_los_filter(model)
    local f={LP.Character}; if model then f[#f+1]=model end
    rage_lite_knife_params.FilterDescendantsInstances=f
end
local function rage_lite_knife_clear(from,to,model)
    rage_lite_los_filter(model)
    local dir=to-from
    if dir.Magnitude<0.01 then return true end
    local hit=workspace:Raycast(from,dir,rage_lite_knife_params)
    return not hit or hit.Instance:IsDescendantOf(model)
end
local function rage_lite_knife_side(now,offset)
    return CFrame.Angles(0,offset+now*(rage_lite.knife_side>=0 and 1 or -1),0)
end
local function rage_lite_knife_pick(model,center,origin,now,distance)
    local bestOffset,bestClear=0,false
    for i=0,8 do
        local offset=(i/8)*math.pi*2
        local probe=center+CFrame.Angles(0,offset,0).LookVector*distance
        if rage_lite_knife_clear(probe,origin,model) then bestOffset,bestClear=offset,true; break end
    end
    return {offset=bestOffset,distance=distance,clear=bestClear}
end
local function rage_lite_compute_knife(fighter,targetPart,distance,isBlocking)
    if not fighter or not targetPart then return CFrame.new(),CFrame.new() end
    local model=fighter.Entity and fighter.Entity.Model
    local hrp=model and model:FindFirstChild("HumanoidRootPart")
    if not hrp then
        local fallback=targetPart.Position-targetPart.CFrame.LookVector*RAGE_LITE_KNIFE_BEHIND
        return CFrame.lookAt(fallback,targetPart.Position),CFrame.lookAt(fallback+RAGE_LITE_UPPER,targetPart.Position)
    end
    local ok,ping=pcall(LP.GetNetworkPing,LP)
    local predict=math.clamp((ok and tonumber(ping) or 0.05)*RAGE_LITE_KNIFE_LAG+RAGE_LITE_KNIFE_LAG_PAD,0.05,RAGE_LITE_KNIFE_PREDICT)
    local velocity=hrp.AssemblyLinearVelocity
    local velShift=velocity*predict
    local dist=math.max(distance-RAGE_LITE_KNIFE_SAFE-math.min(velShift.Magnitude,RAGE_LITE_KNIFE_SHIFT),RAGE_LITE_KNIFE_BEHIND)
    local lookFlat=hrp.CFrame.LookVector
    local baseYaw=math.atan2(-lookFlat.X,-lookFlat.Z)
    local slideXZ=Vector3.new(velocity.X,0,velocity.Z)
    local slideYaw=slideXZ.Magnitude>RAGE_LITE_KNIFE_SLIDE_SPEED and math.atan2(-slideXZ.X,-slideXZ.Z) or baseYaw
    local now=os.clock(); local origin=hrp.Position
    if isBlocking then
        local flat=Vector3.new(lookFlat.X,0,lookFlat.Z)
        flat=flat.Magnitude>0.001 and flat.Unit or Vector3.new(0,0,-1)
        local right=CFrame.lookAt(Vector3.zero,flat).RightVector
        local base=hrp.Position+RAGE_LITE_UPPER-flat*RAGE_LITE_KNIFE_SHIELD_BACK
        local sidePos=base+right*(rage_lite.knife_side*RAGE_LITE_KNIFE_SHIELD_SIDE)
        if not rage_lite_knife_clear(sidePos,origin,model) and now>=rage_lite.knife_repick_at then
            rage_lite.knife_repick_at=now+RAGE_LITE_KNIFE_ROTATE
            rage_lite.knife_side=-rage_lite.knife_side
            sidePos=base+right*(rage_lite.knife_side*RAGE_LITE_KNIFE_SHIELD_SIDE)
        end
        local lower=sidePos-RAGE_LITE_UPPER
        local upper=sidePos+velShift
        return CFrame.lookAt(lower,lower+flat),CFrame.lookAt(upper,upper+flat)
    end
    local centerXZ=Vector3.new(hrp.Position.X,origin.Y,hrp.Position.Z)
    if not rage_lite.knife_plan or rage_lite.knife_model~=model or rage_lite.knife_plan.distance>dist then
        rage_lite.knife_plan=rage_lite_knife_pick(model,centerXZ,origin,now,dist)
        rage_lite.knife_model=model
    end
    local targetPos=centerXZ+rage_lite_knife_side(now,rage_lite.knife_plan.offset or 0)*rage_lite.knife_plan.distance
    if not rage_lite_knife_clear(targetPos,origin,model) and now>=rage_lite.knife_repick_at then
        rage_lite.knife_repick_at=now+RAGE_LITE_KNIFE_ROTATE
        rage_lite.knife_plan=rage_lite_knife_pick(model,centerXZ,origin,now,dist)
        targetPos=centerXZ+rage_lite_knife_side(now,rage_lite.knife_plan.offset or 0)*rage_lite.knife_plan.distance
    end
    if (targetPos-origin).Magnitude>dist then targetPos=origin+(targetPos-origin).Unit*dist end
    local lower=targetPos-RAGE_LITE_UPPER
    return CFrame.lookAt(lower,Vector3.new(origin.X,lower.Y,origin.Z)),CFrame.lookAt(targetPos+velShift,origin+velShift)
end
local function rage_lite_fire(item,action,payload)
