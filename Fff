            local g=Instance.new("Part")
            g.Name="gh_cham"; g.Anchored,g.CanCollide,g.CanQuery,g.CanTouch=true,false,false,false
            g.Material=mat; g.Color=color; g.Transparency=transparency
            g.Size=p.Size; g.CFrame=p.CFrame; g.Parent=workspace
            table.insert(parts,g)
        end
    end
    return parts,duration,transparency
end
local function stepChams(now)
    for i=#activeChams,1,-1 do
        local c=activeChams[i]
        local elapsed=now-(c.endTime-c.duration)
        local a=math.clamp(elapsed/c.duration,0,1)
        local t=c.startTransparency+(1-c.startTransparency)*a
        for _,p in c.parts do if p.Parent then p.Transparency=t end end
        if a>=1 then
            for _,p in c.parts do p:Destroy() end
            table.remove(activeChams,i)
        end
    end
end

