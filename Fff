function Weather:_rebuild()
    for _,e in self._emitters do e.Emitter:Destroy() end
    self._emitters={}
    if not self._cfg.enabled then return end
    local spec={Texture="rbxasset://textures/particles/smoke_main.dds",TransparencyMax=0.35,LifetimeMin=1.2,LifetimeMax=1.8,BaseRate=600,SpeedMin=70,SpeedMax=90,SizeStart=0.12,SizeEnd=0.1,BaseSpread=0.05,BaseAccelerationY=-40}
