    self._right=Instance.new("Frame"); self._right.BackgroundTransparency=1; self._right.Size=UDim2.fromScale(1,1); self._right.Parent=gui
end
function SideFx:_band(parent,side,color,zIndex,cfg)
    local anchorX=side=="Right" and 1 or 0
    local rotation=side=="Right" and 180 or 0
    local frame=Instance.new("Frame")
    frame.AnchorPoint=Vector2.new(anchorX,0.5)
    frame.Position=UDim2.fromScale(anchorX,0.5)
    frame.Size=UDim2.fromScale(0,1)
    frame.BackgroundColor3=color
    frame.BackgroundTransparency=1
    frame.BorderSizePixel=0
    frame.ZIndex=zIndex
    frame.Parent=parent
    local grad=Instance.new("UIGradient")
    grad.Rotation=rotation
    grad.Color=ColorSequence.new({ColorSequenceKeypoint.new(0,color),ColorSequenceKeypoint.new(0.35,color:Lerp(Color3.new(1,1,1),0.14)),ColorSequenceKeypoint.new(1,color)})
    grad.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,0.9),NumberSequenceKeypoint.new(0.22,0.94),NumberSequenceKeypoint.new(0.62,0.985),NumberSequenceKeypoint.new(1,1)})
    grad.Parent=frame
