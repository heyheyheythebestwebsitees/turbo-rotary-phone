local function playLibSound(name,vol,pitch)
    local id=BUILTIN_SOUNDS[name]; if not id then return end
    local s=Instance.new("Sound")
    s.SoundId=id; s.Volume=vol or 1; s.PlaybackSpeed=pitch or 1
    s.PlayOnRemove=true; s.Parent=SoundService; s:Destroy()
end
local function playCustomSound(idOrUrl,vol,pitch)
    if type(idOrUrl)~="string" or idOrUrl=="" then return end
    local sid=idOrUrl
    if not sid:match("^rbxasset") and not sid:match("^https?://") then
        local n=sid:match("%d+"); if n then sid="rbxassetid://"..n else return end
    end
    local s=Instance.new("Sound")
    s.SoundId=sid; s.Volume=vol or 1; s.PlaybackSpeed=pitch or 1
    s.PlayOnRemove=true; s.Parent=SoundService; s:Destroy()
end
local function playSoundCfg(cfg)
    if not cfg or not cfg.enabled then return end
    if type(cfg.customId)=="string" and cfg.customId~="" then
        playCustomSound(cfg.customId,cfg.volume,cfg.pitch)
    else
        playLibSound(cfg.sound or "Headshot",cfg.volume,cfg.pitch)
    end
end

local Sink={_enabled=false,_active=false,_char=nil,_hum=nil,_root=nil,_groundY=nil,_headOffset=2.5,_parts={}}
local SINK_EXTRA_DEPTH=1.5

local function sink_findGroundY(origin,length)
    local filter={}
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr.Character then filter[#filter+1]=plr.Character end
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances=filter
    params.IgnoreWater=true
    pcall(function() params.RespectCanCollide=true end)
    local result=workspace:Raycast(origin,Vector3.new(0,-length,0),params)
    return result and result.Position.Y or nil
end

function Sink:_deactivate(lift)
    if not self._active then return end
    self._active=false
    if lift and self._root and self._root.Parent and self._char and self._char.Parent then
        local gy=sink_findGroundY(self._root.Position+Vector3.new(0,self._headOffset+3,0),40) or self._groundY
        if gy then
            local hip=self._hum and self._hum.HipHeight or 0
            local standH=(hip>=1 and (hip+self._root.Size.Y/2)) or 3
            self._root.CFrame=self._root.CFrame+Vector3.new(0,(gy+standH+0.5)-self._root.Position.Y,0)
            self._root.AssemblyLinearVelocity=Vector3.zero
        end
    end
    for part in pairs(self._parts) do
        if part.Parent then part.CanCollide=true end
    end
    table.clear(self._parts)
    self._char,self._hum,self._root,self._groundY=nil,nil,nil,nil
end

function Sink:_activate(char,hum,root)
    local gy=sink_findGroundY(root.Position+Vector3.new(0,1,0),30)
    if not gy then return false end
    local fallen=workspace.FallenPartsDestroyHeight
    local head=char:FindFirstChild("Head")
    local offset=2.5
    if head and head:IsA("BasePart") then
        offset=(head.Position.Y+head.Size.Y/2)-root.Position.Y
    end
    offset=math.clamp(offset,1.5,4)
    if fallen==fallen and (gy-offset-SINK_EXTRA_DEPTH)<fallen+10 then return false end
    self._char,self._hum,self._root=char,hum,root
    self._groundY,self._headOffset=gy,offset
    table.clear(self._parts)
    for _,d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then self._parts[d]=true end
    end
    self._active=true
    return true
end

RunService.PreSimulation:Connect(function()
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local root=char and char:FindFirstChild("HumanoidRootPart")
    local alive=hum~=nil and root~=nil and hum.Health>0
    if Sink._active then
        if not alive or char~=Sink._char or root~=Sink._root then
            Sink:_deactivate(false)
        elseif not Sink._enabled then
            Sink:_deactivate(true); return
        end
    end
    if not Sink._enabled or not alive then return end
    if not Sink._active and not Sink:_activate(char,hum,root) then
        Sink._enabled=false
        Notify("Sink","No safe ground below")
        return
    end
    local pos=Sink._root.Position
    local newGround=sink_findGroundY(Vector3.new(pos.X,Sink._groundY+4,pos.Z),24)
    if newGround then Sink._groundY=newGround end
    local targetY=Sink._groundY-Sink._headOffset-SINK_EXTRA_DEPTH
    local fallen=workspace.FallenPartsDestroyHeight
    if fallen==fallen and targetY<fallen+10 then
        Sink._enabled=false; Sink:_deactivate(true); return
    end
    for part in pairs(Sink._parts) do
        if part.Parent then part.CanCollide=false end
    end
    for _,d in ipairs(Sink._char:GetDescendants()) do
        if d:IsA("BasePart") and d.CanCollide then
            Sink._parts[d]=true; d.CanCollide=false
        end
    end
    Sink._root.CFrame=Sink._root.CFrame+Vector3.new(0,targetY-pos.Y,0)
    local v=Sink._root.AssemblyLinearVelocity
    Sink._root.AssemblyLinearVelocity=Vector3.new(v.X,0,v.Z)
end)
getgenv().IronNailV2.Sink=Sink

local Stretch={_bind=nil,_ctype=nil,cfg=config.stretch}
function Stretch:_matrix()
    local c=self.cfg
    if not c.enabled or c.x<=0 or c.y<=0 then return nil end
    return CFrame.new(0,0,0,c.x,0,0,0,c.y,0,0,0,1)
end
function Stretch:_unbind()
    if not self._bind then return end
    pcall(function() RunService:UnbindFromRenderStep(self._bind) end)
    self._bind=nil
    if Cam and self._ctype then Cam.CameraType=self._ctype; self._ctype=nil end
end
function Stretch:Apply()
    self:_unbind()
    local id=tostring(math.random(1e9,2e9)); self._bind=id
    RunService:BindToRenderStep(id,Enum.RenderPriority.Camera.Value+1,function()
        local cam=workspace.CurrentCamera; if not cam then return end
        local m=self:_matrix()
        if not m then if self._ctype then cam.CameraType=self._ctype; self._ctype=nil end return end
        if not self._ctype then self._ctype=cam.CameraType end
        cam.CameraType=Enum.CameraType.Track
        cam.CFrame=cam.CFrame*m
    end)
end
function Stretch:Update() if self.cfg.enabled then self:Apply() else self:_unbind() end end

