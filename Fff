        local target=fake_position_saved_cframe.Position-Vector3.new(0,tonumber(Sleepy_Config.FakePositionY) or 0,0)
        if Sleepy_Config.FakePositionPanic then
            local xmin=tonumber(Sleepy_Config.PanicPositionXMin) or 0
            local xmax=tonumber(Sleepy_Config.PanicPositionXMax) or 0
            if xmax<xmin then xmin,xmax=xmax,xmin end
            target=target+Vector3.new(xmin+math.random()*(xmax-xmin),0,0)
        end
        hrp.AssemblyLinearVelocity=Vector3.zero; hrp.AssemblyAngularVelocity=Vector3.zero
        hrp.CFrame=CFrame.new(target)
        set_position_desync("fake",fake_position_saved_cframe,hrp.CFrame)
        return
    end
    local saved=fake_position_saved_cframe
    if saved then hrp.CFrame=saved; fake_position_saved_cframe=nil end
    if not g.GodOriginalPos then g.GodOriginalPos=hrp.CFrame end
    local target=g.GodOriginalPos.Position-Vector3.new(0,tonumber(Sleepy_Config.FakePositionY) or 0,0)
    if Sleepy_Config.FakePositionPanic then
