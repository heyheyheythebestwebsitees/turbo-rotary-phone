    local skeletonProjCache={}
    local function paintSkeleton(entry,character,camera)
        if not entry.bones then return end
        local idx=1
        local links=if character:FindFirstChild("UpperTorso") then SKELETON_R15 else SKELETON_R6
        table.clear(skeletonProjCache)
        local function jp(name)
            local cached=skeletonProjCache[name]
            if cached~=nil then return if cached==false then nil else cached end end
            local p=character:FindFirstChild(name)
            if p and p:IsA("BasePart") then
                local r=projectPart(camera,p); skeletonProjCache[name]=r or false; return r
            end
            skeletonProjCache[name]=false; return nil
        end
        for _,link in links do
            if idx>#entry.bones then break end
            local a=jp(link[1]); local b=jp(link[2])
            if a and b then drawBone(entry.bones[idx],a,b,Esp.skeletonColor,Esp.skeletonOutline); idx+=1 end
        end
        for i=idx,#entry.bones do
            if entry.bones[i].line.Visible then entry.bones[i].line.Visible=false end
            if entry.bones[i].outline.Visible then entry.bones[i].outline.Visible=false end
        end
    end
    local function paintArrow(entry,camera,worldPos)
        if not (Esp.arrows and entry and entry.arrow and entry.arrowL and entry.arrowR) then
            if entry then
                if entry.arrow then entry.arrow.Visible=false end
                if entry.arrowL then entry.arrowL.Visible=false end
                if entry.arrowR then entry.arrowR.Visible=false end
            end
            return
        end
        local vp=camera.ViewportSize
        local cx,cy=vp.X*0.5,vp.Y*0.5
        local s=camera:WorldToViewportPoint(worldPos)
        local dx,dy=s.X-cx,s.Y-cy
        if s.Z<=0 then dx,dy=-dx,-dy end
        local mag=math.sqrt(dx*dx+dy*dy)
        if mag<1 then dx,dy,mag=0,-1,1 end
        dx/=mag; dy/=mag
        local r=math.clamp(Esp.arrowsRadius,20,400)
        local tipX=math.floor(cx+dx*r+0.5); local tipY=math.floor(cy+dy*r+0.5)
        local backX=tipX-dx*14; local backY=tipY-dy*14
        local px,py=-dy,dx
        local leftX=math.floor(backX+px*7+0.5); local leftY=math.floor(backY+py*7+0.5)
        local rightX=math.floor(backX-px*7+0.5); local rightY=math.floor(backY-py*7+0.5)
        local pulse=0.2+0.8*(0.5+0.5*math.sin(os.clock()*5))
        local paint=Esp.arrowsColor
        if entry._aTX~=tipX or entry._aTY~=tipY or entry._aLX~=leftX or entry._aLY~=leftY or entry._aRX~=rightX or entry._aRY~=rightY then
            entry._aTX,entry._aTY=tipX,tipY
            entry._aLX,entry._aLY=leftX,leftY
            entry._aRX,entry._aRY=rightX,rightY
            entry.arrow.From=Vector2.new(leftX,leftY); entry.arrow.To=Vector2.new(tipX,tipY)
            entry.arrowL.From=Vector2.new(rightX,rightY); entry.arrowL.To=Vector2.new(tipX,tipY)
            entry.arrowR.From=Vector2.new(leftX,leftY); entry.arrowR.To=Vector2.new(rightX,rightY)
        end
        entry.arrow.Color=paint; entry.arrowL.Color=paint; entry.arrowR.Color=paint
        entry.arrow.Visible=true; entry.arrowL.Visible=true; entry.arrowR.Visible=true
        setDrawAlpha(entry.arrow,pulse); setDrawAlpha(entry.arrowL,pulse); setDrawAlpha(entry.arrowR,pulse)
    end

