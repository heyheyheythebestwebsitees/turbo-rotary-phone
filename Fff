    local spoofPdcCache,spoofPdcAt=nil,0

    local function spoofAnyOn()
        return Spoof.nameOn or Spoof.levelOn or Spoof.xpOn or Spoof.streakOn or Spoof.rankOn or Spoof.eloOn or Spoof.keysOn or Spoof.deviceOn
    end
    local function spoofNameText()
        local n=Spoof.name
        if type(n)=="string" and n~="" then return n end
        return "sonata"
    end
    local function refreshSeasonCache()
        pcall(function()
            local sl=require(RS.Modules.SeasonLibrary)
            if sl and sl.CurrentSeason and type(sl.CurrentSeason.Name)=="string" then cachedSeasonName=sl.CurrentSeason.Name end
            if cachedEloRank==Spoof.rank then return end
            cachedEloRank=Spoof.rank
            cachedEloValue=3700
            local profile=sl and sl.CurrentSeason and sl.CurrentSeason.RankProfile
            if not profile then return end
            local ranks=profile.Ranks; local order=profile.RanksOrder
            local info=ranks and ranks[Spoof.rank]
            if type(info)~="table" or typeof(info.RequiredELO)~="number" then return end
            local required=info.RequiredELO
            if required<0 then cachedEloValue=0; return end
            if info.RequiredELOLeaderboardRanking then cachedEloValue=required+400; return end
            if type(order)=="table" then
                local idx=table.find(order,Spoof.rank)
                if idx and order[idx+1] and ranks[order[idx+1]] then
                    local nextReq=ranks[order[idx+1]].RequiredELO
                    if typeof(nextReq)=="number" and nextReq>required then
                        cachedEloValue=math.floor((required+nextReq)*0.5); return
                    end
                end
            end
            cachedEloValue=required+50
        end)
    end
    local function spoofEloForRank(rank)
        if cachedEloRank~=rank then refreshSeasonCache() end
        return cachedEloValue
    end
    local function spoofSeasonElo()
        if Spoof.eloOn then return math.clamp(math.floor(Spoof.elo),0,999999) end
        if Spoof.rankOn then return spoofEloForRank(Spoof.rank) end
        return cachedEloValue
    end
    local function eloSpoofOn() return Spoof.rankOn==true or Spoof.eloOn==true end
    local function isLocalUserId(id) return LP~=nil and id~=nil and tostring(id)==tostring(LP.UserId) end
    local function isLocalElo(elo)
        if type(elo)~="number" then return false end
        return elo==spoofSeasonElo() or elo==realDisplayElo or elo==realSeasonElo
    end

    local function ensureRankHooks()
        if spoofRankHooked then return end
        local ok,sl=pcall(function() return require(RS.Modules.SeasonLibrary) end)
        if not ok or type(sl)~="table" then return end
        if type(sl.GetHighestELOLeaderboardRanking)=="function" then
            hookGameMethod(sl.GetHighestELOLeaderboardRanking,function(old,self,elo,userId,...)
                if Spoof.rankOn and isLocalUserId(userId) then
                    return if Spoof.rank=="Archnemesis" then 1 else nil
                end
                return old(self,elo,userId,...)
            end)
        end
        if type(sl.GetRank)=="function" then
            hookGameMethod(sl.GetRank,function(old,self,elo,userId,ranking,profileName,...)
                if Spoof.rankOn and profileName==nil and isLocalUserId(userId) and isLocalElo(elo) then
                    local season=type(self)=="table" and self.CurrentSeason
                    local ranks=season and season.RankProfile and season.RankProfile.Ranks
                    if type(ranks)~="table" or ranks[Spoof.rank]~=nil then return Spoof.rank end
                end
                return old(self,elo,userId,ranking,profileName,...)
            end)
        end
        spoofRankHooked=true
    end

    local function rawDisplayElo(lp)
        local ok,v=pcall(lp.GetAttribute,lp,"DisplayELO")
        return if ok then v else nil
    end
    local function currentSeasonEntry(pdc)
        local seasons=pdc:Get("Seasons")
        if type(seasons)~="table" then return nil,nil end
        return seasons,seasons[cachedSeasonName]
    end
    local function applyEloSpoof(lp,pdc)
        local elo=spoofSeasonElo()
        local raw=rawDisplayElo(lp)
        if type(raw)=="number" and raw~=elo and raw~=lastAppliedElo then realDisplayElo=raw end
        if raw~=elo then pcall(lp.SetAttribute,lp,"DisplayELO",elo) end
        if pdc then
            pcall(function()
                local seasons,season=currentSeasonEntry(pdc)
                if type(seasons)~="table" then seasons={}; pdc:Set("Seasons",seasons) end
                if type(season)~="table" then season={ResetCounter=0,CurrentELO=elo,RankedPerformances={ranked={}}}; seasons[cachedSeasonName]=season end
                local cur=season.CurrentELO
                if type(cur)=="number" and cur~=elo and cur~=lastAppliedElo then realSeasonElo=cur end
                season.CurrentELO=elo
                local sig=pdc:GetDataChangedSignal("Seasons")
                if sig and type(sig.Fire)=="function" then sig:Fire(seasons,"Seasons") end
            end)
        end
        lastAppliedElo=elo
        eloSpoofApplied=true
    end
    local function restoreEloSpoof()
        if not eloSpoofApplied then return end
        eloSpoofApplied=false
        lastAppliedElo=nil
        if LP and realDisplayElo~=nil then pcall(LP.SetAttribute,LP,"DisplayELO",realDisplayElo) end
        local pdc=spoofPdcCache
        if pdc and realSeasonElo~=nil then
            pcall(function()
                local _,season=currentSeasonEntry(pdc)
                if type(season)=="table" then season.CurrentELO=realSeasonElo end
            end)
        end
    end

    local function captureRealNames(lp)
        spoofLocalPlayer=lp
        if realUserName==nil then realUserName=lp.Name end
        if realDisplayName==nil then realDisplayName=lp.DisplayName end
    end

    local function ensureNameMetamethod()
        if spoofNameHooked then return end
        local hf=execApi("hookmetamethod") or hookmetamethod
        if typeof(hf)~="function" then return end
        if not LP then return end
        captureRealNames(LP)
        local ok=pcall(function()
            local oldIndex
            oldIndex=hf(game,"__index",function(self,key)
                if SESSION.alive and (key=="Name" or key=="DisplayName") then
                    if Spoof.nameOn and spoofLocalPlayer~=nil and self==spoofLocalPlayer then
                        return spoofNameText()
                    end
                end
                return oldIndex(self,key)
            end)
        end)
        if ok then spoofNameHooked=true end
    end
    local function ensureAttrMetamethod()
        if spoofAttrHooked then return end
        local hf=execApi("hookmetamethod") or hookmetamethod
        local gnm=execApi("getnamecallmethod") or getnamecallmethod
        if typeof(hf)~="function" or typeof(gnm)~="function" then return end
        local ok=pcall(function()
            local oldNamecall
            oldNamecall=hf(game,"__namecall",function(self,...)
                local me=spoofLocalPlayer
                if SESSION.alive and me~=nil and self==me then
                    local m=gnm()
                    if m=="GetAttribute" then
                        local k=...
                        if k=="Level" and Spoof.levelOn then return math.clamp(math.floor(Spoof.level),0,99999) end
                        if k=="StatisticDuelsWinStreak" and Spoof.streakOn then return math.clamp(math.floor(Spoof.streak),0,999999) end
                        if k=="DisplayELO" and eloSpoofOn() then return spoofSeasonElo() end
                    end
                end
                return oldNamecall(self,...)
            end)
        end)
        if ok then spoofAttrHooked=true end
    end

    local function spoofScalarGet(key)
        if key=="Level" and Spoof.levelOn then return math.clamp(math.floor(Spoof.level),0,99999) end
        if key=="XP" and Spoof.xpOn then return math.clamp(math.floor(Spoof.xp),0,99999999) end
        if key=="StatisticDuelsWinStreak" and Spoof.streakOn then return math.clamp(math.floor(Spoof.streak),0,999999) end
        if key=="WeaponKeys" and Spoof.keysOn then return math.clamp(math.floor(Spoof.keys),0,9999999) end
        return nil
    end
    local function spoofPlayerData()
        local now=os.clock()
        if spoofPdcCache~=nil and now-spoofPdcAt<5 then return spoofPdcCache end
        local lp=LP
        if not lp then return nil end
        local ok,pdc=pcall(function() return require(lp.PlayerScripts.Controllers.PlayerDataController) end)
        if ok and pdc~=nil then spoofPdcCache=pdc; spoofPdcAt=now; return pdc end
        return spoofPdcCache
    end

    local function ensurePdcHooks()
        if spoofPdcHooked then return end
        local pdc=spoofPlayerData()
        if not pdc then return end
        if type(pdc.Get)=="function" then
            local old=hookGameMethod(pdc.Get,function(prev,self,key,...)
                local forced=spoofScalarGet(key)
                if forced~=nil then return forced end
                local ok,value=pcall(prev,self,key,...)
                if not ok then return nil end
                if key=="Seasons" and eloSpoofOn() and type(value)=="table" then
                    local season=value[cachedSeasonName]
                    if type(season)=="table" then
                        local elo=spoofSeasonElo()
                        local cur=season.CurrentELO
                        if type(cur)=="number" and cur~=elo and cur~=lastAppliedElo then realSeasonElo=cur end
                        season.CurrentELO=elo
                    end
                end
                return value
            end)
            if old then spoofPdcHooked=true end
        end
    end

    local function ensureSetControlsHook()
        if spoofSetControlsHooked then return end
        local remotes=RS:FindFirstChild("Remotes")
        local repl=remotes and remotes:FindFirstChild("Replication")
        local ff=repl and repl:FindFirstChild("Fighter")
        local rem=ff and ff:FindFirstChild("SetControls")
        if not (rem and rem:IsA("RemoteEvent")) then return end
        spoofSetControlsRemote=rem
        local old=rem.FireServer
        rem.FireServer=function(self,scheme,...)
            if Spoof.deviceOn then scheme=DEVICE_TO_CONTROLS[Spoof.device] or scheme end
            return old(self,scheme,...)
        end
        spoofSetControlsHooked=true
    end

    local function ensureSpoofHooks()
        if spoofHooksReady then ensureNameMetamethod(); ensureAttrMetamethod(); ensureRankHooks(); ensurePdcHooks(); ensureSetControlsHook(); return end
        if not LP then return end
        spoofLocalPlayer=LP
        refreshSeasonCache()
        ensureNameMetamethod(); ensureAttrMetamethod(); ensureRankHooks(); ensurePdcHooks(); ensureSetControlsHook()
        spoofHooksReady=true
    end

    local function applySpoofName()
        if not LP or not Spoof.nameOn then return end
        captureRealNames(LP)
        ensureSpoofHooks()
        local n=spoofNameText()
        if lastDisplayApplied==n and lastNameApplied==n then return end
        lastDisplayApplied=n; lastNameApplied=n
        pcall(function() LP.DisplayName=n end)
        pcall(function() LP.Name=n end)
    end

    local function spoofWriteKey(pdc,key,value,attrName)
        pcall(function()
            local data=pdc.CurrentData
            if data and type(data.Set)=="function" then data:Set(key,value)
            else pdc:Set(key,value) end
            if attrName and LP then LP:SetAttribute(attrName,value) end
            local sig=pdc:GetDataChangedSignal(key)
            if sig and type(sig.Fire)=="function" then sig:Fire(value,key) end
        end)
    end

    local function applySpoofProfile()
        local pdc=spoofPlayerData()
        if not LP or not pdc then return end
        ensureSpoofHooks()
        if Spoof.nameOn then applySpoofName() end
        if Spoof.levelOn then
            local level=math.clamp(math.floor(Spoof.level),0,99999)
            if lastAttrLevel~=level then lastAttrLevel=level; spoofWriteKey(pdc,"Level",level,"Level")
            else pcall(function() LP:SetAttribute("Level",level) end) end
        end
        if Spoof.xpOn then spoofWriteKey(pdc,"XP",math.clamp(math.floor(Spoof.xp),0,99999999),nil) end
        if Spoof.streakOn then
            local streak=math.clamp(math.floor(Spoof.streak),0,999999)
            if lastAttrStreak~=streak then lastAttrStreak=streak; spoofWriteKey(pdc,"StatisticDuelsWinStreak",streak,"StatisticDuelsWinStreak")
            else pcall(function() LP:SetAttribute("StatisticDuelsWinStreak",streak) end) end
        end
        if eloSpoofOn() then
            if Spoof.rankOn then refreshSeasonCache() end
            applyEloSpoof(LP,pdc)
        else restoreEloSpoof() end
    end

    local function applySpoofKeys()
        local pdc=spoofPlayerData()
        if not pdc or not Spoof.keysOn then return end
        ensureSpoofHooks()
        spoofWriteKey(pdc,"WeaponKeys",math.clamp(math.floor(Spoof.keys),0,9999999),nil)
    end

    local function realLocalControls()
        local ok,mod=pcall(function() return LP and require(LP.PlayerScripts.Controllers.ControlsController) end)
        if ok and type(mod)=="table" and type(mod.CurrentControls)=="string" then return mod.CurrentControls end
        return nil
    end
    local function applyDeviceSpoof()
        ensureSpoofHooks()
        if not Spoof.deviceOn then
            if lastDeviceApplied~=nil then
                lastDeviceApplied=nil
                local real=realLocalControls()
                if real and spoofSetControlsRemote then pcall(function() spoofSetControlsRemote:FireServer(real) end) end
            end
            return
        end
        local c=DEVICE_TO_CONTROLS[Spoof.device] or "MouseKeyboard"
        if lastDeviceApplied==c then return end
        lastDeviceApplied=c
        if spoofSetControlsRemote then pcall(function() spoofSetControlsRemote:FireServer(c) end) end
    end

    DrawingBridge.revertSpoof=function()
        for k,v in Spoof do
            if type(v)=="boolean" and string.sub(k,-2)=="On" then Spoof[k]=false end
        end
        pcall(restoreEloSpoof)
        pcall(applyDeviceSpoof)
        if LP and realDisplayName then
            pcall(function() LP.DisplayName=realDisplayName end)
            pcall(function() LP.Name=realUserName or LP.Name end)
        end
    end
    DrawingBridge.applySpoofAll=function()
        lastAttrLevel,lastAttrStreak=nil,nil
        lastDisplayApplied,lastNameApplied,lastDeviceApplied=nil,nil,nil
        cachedEloRank=nil
        applySpoofProfile(); applySpoofKeys(); applyDeviceSpoof()
    end

    local lastPulse,lastStatsPulse=0,0
    RunService.Heartbeat:Connect(function()
        if not spoofAnyOn() then return end
        if not spoofHooksReady then ensureSpoofHooks() end
        local now=os.clock()
        if now-lastPulse<1.5 then return end
        lastPulse=now
        if not LP then return end
        spoofLocalPlayer=LP
        if Spoof.nameOn then applySpoofName() end
        if Spoof.levelOn then
            local lvl=math.clamp(math.floor(Spoof.level),0,99999)
            if LP:GetAttribute("Level")~=lvl then LP:SetAttribute("Level",lvl) end
        end
        if Spoof.streakOn then
            local s=math.clamp(math.floor(Spoof.streak),0,999999)
            if LP:GetAttribute("StatisticDuelsWinStreak")~=s then LP:SetAttribute("StatisticDuelsWinStreak",s) end
        end
        if eloSpoofOn() and rawDisplayElo(LP)~=spoofSeasonElo() then applyEloSpoof(LP,nil) end
        if now-lastStatsPulse>=4 then
            lastStatsPulse=now
            if Spoof.xpOn or Spoof.keysOn or Spoof.rankOn or Spoof.eloOn or Spoof.levelOn or Spoof.streakOn then applySpoofProfile() end
            if Spoof.keysOn then applySpoofKeys() end
        end
        if Spoof.deviceOn then applyDeviceSpoof() end
    end)
end

local RageState={
    evasionEnabled=false,evasion="Scatter",evasionRadius=100,evasionRandom=0.5,
    translocateOffset=-5,
    underground=false,undergroundY=-2,
    fakePos=false,fakeRadius=72,fakeSpeed=96,fakeIntensity=100,stability=0.15,
    voidSpam=false,attackTime=1,voidTime=0.3,
    enabled=false,
}
DrawingBridge.Rage=RageState

local desyncLocked,desyncRestoreBound,desyncRestoreRoot,desyncRestoreCF,desyncShownCF
local desyncRestoreVel,desyncRestoreAngVel=Vector3.zero,Vector3.zero
local lastServerCF

local function findCharacterController(fighter)
    local ctrl
    local scripts=LP and LP:FindFirstChild("PlayerScripts")
    local controllers=scripts and scripts:FindFirstChild("Controllers")
    local mod=controllers and controllers:FindFirstChild("CharacterController")
    if mod then
        local ok,l=pcall(require,mod)
        if ok and type(l)=="table" and type(l.SetServerCFrame)=="function" then return l end
    end
    if fighter then
        pcall(function()
            local c=fighter:Get("CharacterController")
            if type(c)=="table" and type(c.SetServerCFrame)=="function" then ctrl=c end
        end)
    end
    return ctrl
end
local function setServerReplicaCF(cf,viewAngles)
    local fc=getControllers()
    local localFighter=fc and fc.LocalFighter
    local ctrl=findCharacterController(localFighter)
    if not ctrl then return false end
    local ok=false
    callAsGame(function()
        ctrl:SetServerCFrame(cf)
        if type(ctrl.SendViewAngles)=="function" then ctrl:SendViewAngles(20,viewAngles) end
        ok=true
    end)
    if ok then lastServerCF=cf end
    return ok
end
local function clearServerReplica() setServerReplicaCF(nil,nil); lastServerCF=nil end
DrawingBridge.clearRageServer=clearServerReplica

local function isDangerRagePos(pos)
    pcall(function()
        local gu=require(RS.Modules.GameplayUtility)
        if type(gu)=="table" and type(gu.IsWithinOOBPart)=="function" then
            local ok,oob=pcall(function() return gu:IsWithinOOBPart(pos) end)
            if ok and oob then return true end
        end
    end)
    pcall(function()
        local util=require(RS.Modules.Utility)
        if type(util)=="table" and type(util.IsWithinTaggedParts)=="function" then
            local ok,hit=pcall(function() return util:IsWithinTaggedParts("Barrier",pos) end)
            if ok and hit then return true end
        end
    end)
    return false
end

local SAFE_TP_OFFSETS={Vector3.zero,Vector3.new(0,2,0),Vector3.new(0,4,0),Vector3.new(2,2,0),Vector3.new(-2,2,0),Vector3.new(0,2,2),Vector3.new(0,2,-2),Vector3.new(3,1,3),Vector3.new(-3,1,3),Vector3.new(3,1,-3),Vector3.new(-3,1,-3),Vector3.new(0,6,0),Vector3.new(0,1,4),Vector3.new(0,1,-4),Vector3.new(4,1,0),Vector3.new(-4,1,0)}
local function resolveSafeDesyncCF(cf,strict)
    local lookAt=cf.Position+cf.LookVector*8
    if (lookAt-cf.Position).Magnitude<0.05 then lookAt=cf.Position+Vector3.new(0,0,-1) end
    local desired=cf.Position
    if not isDangerRagePos(desired) then return CFrame.lookAt(desired,lookAt) end
    if strict then return nil end
    for _,off in SAFE_TP_OFFSETS do
        local p=desired+off
        if not isDangerRagePos(p) then return CFrame.lookAt(p,lookAt) end
    end
    local root=LP and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") and not isDangerRagePos(root.Position) then
        for t=0.15,1,0.15 do
            local p=desired:Lerp(root.Position,t)
            if not isDangerRagePos(p) then return CFrame.lookAt(p,lookAt) end
        end
        return CFrame.lookAt(root.Position,lookAt)
    end
    return nil
end

local function flushDesyncRestore()
    if desyncRestoreBound then
        desyncRestoreBound=false
        pcall(function() RunService:UnbindFromRenderStep("__gh_rage_restore") end)
    end
    local root=desyncRestoreRoot
    local cf=desyncRestoreCF
    desyncRestoreRoot,desyncRestoreCF,desyncShownCF=nil,nil,nil
    if root and root.Parent and cf then
        pcall(function()
            root.CFrame=cf
            root.AssemblyLinearVelocity=desyncRestoreVel
            root.AssemblyAngularVelocity=desyncRestoreAngVel
        end)
    end
end
local function sameSpot(a,b)
    return a~=nil and b~=nil and (a.Position-b.Position).Magnitude<0.2
end
local function applyDesync(cf,lock,force)
    local safe=if force then cf else resolveSafeDesyncCF(cf,lock==true)
    if not safe then return false,nil end
    if setServerReplicaCF(safe) then
        desyncShownCF=safe
        if lock then desyncLocked=true end
        return true,safe
    end
    local char=LP and LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if not root or not root:IsA("BasePart") then return false,nil end
    local keepAnchor=desyncRestoreCF~=nil and (desyncRestoreBound or sameSpot(root.CFrame,desyncShownCF))
    if not keepAnchor or desyncRestoreRoot~=root then
        desyncRestoreRoot=root
        desyncRestoreCF=root.CFrame
        desyncRestoreVel=root.AssemblyLinearVelocity
        desyncRestoreAngVel=root.AssemblyAngularVelocity
    end
    root.CFrame=safe
    desyncShownCF=safe
    if lock then desyncLocked=true end
    if not desyncRestoreBound then
        desyncRestoreBound=true
        local priority=Enum.RenderPriority.Camera.Value-1
        RunService:BindToRenderStep("__gh_rage_restore",priority,flushDesyncRestore)
    end
    return true,safe
end

local function getMyRoot()
    local char=LP and LP.Character
    local root=char and char:FindFirstChild("HumanoidRootPart")
    if root and root:IsA("BasePart") then return root end
    return nil
end

local function installFakePosRuntime()
    local nextBlink=0
    local function stab() return math.clamp((tonumber(RageState.stability) or 0.15)/1.5,0.05,1) end
    local function blinkWait()
        local speed=math.clamp(tonumber(RageState.fakeSpeed) or 96,1,100)/100
        return (1-speed)*0.22*stab()
    end
    local function reach()
        local radius=math.clamp(tonumber(RageState.fakeRadius) or 72,2,220)
        local intensity=math.clamp(tonumber(RageState.fakeIntensity) or 100,0,100)/100
        local loose=1+(1-stab())*2.4
        return radius*math.max(intensity,0.35)*loose
    end
    local function pickFakeCF(origin,rot)
        local dist=reach()
        local s=stab()
        for _=1,12 do
            local ang=math.random()*math.pi*2
            local flat=dist*(0.35+math.random()*0.65)
            local lift=(math.random()-0.35)*dist*(0.4+(1-s))
            if s>0.97 then
                lift=(if math.random()<0.5 then 1 else -1)*dist
                flat=0
            end
            local pos=origin+Vector3.new(math.cos(ang)*flat,lift,math.sin(ang)*flat)
            if not isDangerRagePos(pos) then return CFrame.new(pos)*rot end
        end
        return nil
    end
    local function blink()
        if not RageState.enabled or not RageState.fakePos then return end
        local now=os.clock()
        local waitFor=blinkWait()
        if waitFor>0 and now<nextBlink then return end
        nextBlink=now+waitFor
        local root=getMyRoot()
        if not root then return end
        local origin=root.Position
        local rot=root.CFrame.Rotation
        if desyncRestoreCF and (desyncLocked or desyncRestoreBound or sameSpot(root.CFrame,desyncShownCF)) then
            origin=desyncRestoreCF.Position
            rot=desyncRestoreCF.Rotation
        end
        local cf=pickFakeCF(origin,rot)
        if cf then applyDesync(cf) end
    end
    local pre=RunService.PreSimulation
    if pre then
        pre:Connect(function()
            if RageState.enabled and RageState.fakePos then blink() end
        end)
    else
        RunService.Heartbeat:Connect(function()
            if RageState.enabled and RageState.fakePos then blink() end
        end)
    end
    local function evasionSpin(pos)
        return CFrame.new(pos)*CFrame.Angles(math.random()*6.28,math.random()*6.28,math.random()*6.28)
    end
    RunService.Heartbeat:Connect(function()
        if not (RageState.enabled and RageState.evasionEnabled) then return end
        local mode=tostring(RageState.evasion or "Scatter")
        if mode=="Off" then return end
        local root=getMyRoot(); if not root then return end
        local origin=root.Position
        local radius=math.clamp(tonumber(RageState.evasionRadius) or 100,5,1e8)
        local jitter=math.clamp(tonumber(RageState.evasionRandom) or 0.5,0,1)
        local ang=math.random()*math.pi*2
        local pos
        if mode=="Orbit" then
            local r=radius*(0.55+0.45*math.random())
            pos=origin+Vector3.new(math.cos(ang)*r,2+math.random()*5,math.sin(ang)*r)
        elseif mode=="Sky" then
            local r=6+math.random()*16
            pos=origin+Vector3.new(math.cos(ang)*r,radius,math.sin(ang)*r)
        elseif mode=="Underground" then
            local depth=math.clamp(tonumber(RageState.translocateOffset) or -12,-80,-1)
            local r=3+math.random()*12
