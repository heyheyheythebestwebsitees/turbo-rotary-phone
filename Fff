end
function SideFx:Play(color,duration)
    self:_init()
    local function build(side,parent)
        local c1=color:Lerp(Color3.new(1,1,1),0.22)
        local c2=color:Lerp(Color3.new(1,1,1),0.72)
        return {
            self:_band(parent,side,color,3,{ExpandedWidth=320,VisibleTransparency=0.94,OvershootWidth=360,FinalWidth=390,HoldTime=0.28}),
            self:_band(parent,side,c1,2,{ExpandedWidth=215,VisibleTransparency=0.76,OvershootWidth=245,FinalWidth=265,HoldTime=0.24}),
            self:_band(parent,side,c2,5,{ExpandedWidth=90,VisibleTransparency=0.56,OvershootWidth=108,FinalWidth=118,HoldTime=0.18}),
        }
    end
    local l=build("Left",self._left)
    local r=build("Right",self._right)
    table.insert(self.flashes,{Elapsed=0,Duration=duration,Bands={l[1],l[2],l[3],r[1],r[2],r[3]}})
    while #self.flashes>14 do
        local f=table.remove(self.flashes,1)
        for _,b in f.Bands do b.Frame:Destroy() end
    end
end
function SideFx:Update(dt)
    for i=#self.flashes,1,-1 do
        local f=self.flashes[i]
        f.Elapsed=f.Elapsed+dt
        local animT=dt*1.35/f.Duration
        for _,b in f.Bands do
            b.Width=b.Width+(b.TargetWidth-b.Width)*math.min(1,12*dt)
            b.Transparency=b.Transparency+(b.TargetTransparency-b.Transparency)*math.min(1,12*dt)
            b.Frame.Size=UDim2.new(0,math.max(0,b.Width),1,0)
            b.Frame.BackgroundTransparency=math.clamp(b.Transparency,0,1)
            if b.Phase=="enter" and math.abs(b.Width-b.TargetWidth)<0.2 then
                b.Phase="hold"; b.HoldElapsed=0
            elseif b.Phase=="hold" then
                b.HoldElapsed=b.HoldElapsed+animT
                if b.HoldElapsed>=b.Config.HoldTime then
                    b.Phase="overshoot"
                    b.TargetWidth=b.Config.OvershootWidth
                    b.TargetTransparency=1
                end
            elseif b.Phase=="overshoot" and math.abs(b.Width-b.TargetWidth)<0.2 then
                b.Phase="final"; b.TargetWidth=b.Config.FinalWidth
            end
        end
        if f.Elapsed>=f.Duration then
            for _,b in f.Bands do b.Frame:Destroy() end
            table.remove(self.flashes,i)
        end
    end
end

